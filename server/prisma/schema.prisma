generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum AccountRole { CLIENT MAESTRO_CONTRACTOR PROFESSIONAL COMPANY ADMIN }
enum VerificationStatus { UNVERIFIED PENDING VERIFIED REJECTED }
enum InteractionType { LIKE FAVORITE PASS }
enum ContractStatus { DRAFT PROPOSED ACCEPTED IN_PROGRESS COMPLETED CANCELLED DISPUTED }
enum ClaimStatus { NEW OPEN IN_REVIEW CLOSED }
enum ProjectVisibility { PUBLIC PRIVATE }
enum ProjectStatus { OPEN IN_PROGRESS COMPLETED CANCELLED }
enum PrivateRequestStatus { PENDING ACCEPTED REJECTED CANCELLED }
enum PrivateRequestKind { PROFILE_INVITATION PROJECT_INTEREST }
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  role AccountRole
  firstName String?
  lastName String?
  phone String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clientProfile ClientProfile?
  professionalProfile ProfessionalProfile?
}
model ClientProfile {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId], references:[id])
  city String @default("Temuco")
  region String @default("La Araucanía")
  publicBio String?
}
model ProfessionalProfile {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId], references:[id])
  businessName String?
  rutEncrypted String?
  verification VerificationStatus @default(UNVERIFIED)
  description String?
  city String @default("Temuco")
  serviceArea String[]
  specialties Specialty[]
  portfolio PortfolioItem[]
  rating Decimal? @db.Decimal(3,2)
  createdAt DateTime @default(now())
}
model Specialty {
  id String @id @default(cuid())
  name String @unique
  professionals ProfessionalProfile[]
}
model PortfolioItem {
  id String @id @default(cuid())
  professionalId String
  professional ProfessionalProfile @relation(fields:[professionalId], references:[id])
  title String
  description String?
  imageUrl String?
  city String?
  createdAt DateTime @default(now())
}
model Interaction {
  id String @id @default(cuid())
  clientUserId String
  professionalId String
  type InteractionType
  createdAt DateTime @default(now())
  @@unique([clientUserId, professionalId, type])
}
model Conversation {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  messages Message[]
}
model Message {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields:[conversationId], references:[id])
  senderUserId String
  body String
  createdAt DateTime @default(now())
}
model Contract {
  id String @id @default(cuid())
  clientUserId String
  professionalId String
  title String
  scope String
  amount Decimal @db.Decimal(14,2)
  currency String @default("CLP")
  status ContractStatus @default(DRAFT)
  startDate DateTime?
  endDate DateTime?
  milestones ContractMilestone[]
  createdAt DateTime @default(now())
}
model ContractMilestone {
  id String @id @default(cuid())
  contractId String
  contract Contract @relation(fields:[contractId], references:[id])
  title String
  amount Decimal @db.Decimal(14,2)
  acceptedAt DateTime?
  releasedAt DateTime?
}
model Review {
  id String @id @default(cuid())
  contractId String
  authorUserId String
  targetProfileId String
  score Int
  comment String?
  createdAt DateTime @default(now())
  @@index([contractId, targetProfileId])
}
model Claim {
  id String @id @default(cuid())
  contractId String?
  openedByUserId String
  targetUserId String?
  title String
  description String
  status ClaimStatus @default(NEW)
  createdAt DateTime @default(now())
  closedAt DateTime?
}
model PaymentReference {
  id String @id @default(cuid())
  userId String
  provider String
  providerToken String
  brand String?
  last4 String?
  createdAt DateTime @default(now())
  // Nunca almacenar PAN completo ni CVV.
}

// Esquema preparado para Beta. La demo actual usa MockRepository y no migra Neon.
model Project {
  id String @id @default(cuid())
  ownerUserId String
  title String
  description String
  category String
  city String @default("Temuco")
  zone String?
  budget Decimal? @db.Decimal(14,2)
  area String?
  timeline String?
  visibility ProjectVisibility @default(PUBLIC)
  status ProjectStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerUserId, status])
  @@index([visibility, category, city])
}

model PrivateRequest {
  id String @id @default(cuid())
  requestKind PrivateRequestKind
  projectId String?
  clientUserId String
  providerUserId String
  senderUserId String
  senderRole AccountRole
  recipientUserId String
  recipientRole AccountRole
  projectTitle String
  description String
  specifications String
  location String
  budget Decimal? @db.Decimal(14,2)
  antecedents String?
  message String
  dedupeKey String @unique
  status PrivateRequestStatus @default(PENDING)
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([recipientUserId, status])
  @@index([clientUserId, createdAt])
  @@index([providerUserId, createdAt])
}

model MarketplaceMatch {
  id String @id @default(cuid())
  projectId String?
  privateRequestId String? @unique
  dedupeKey String @unique
  clientUserId String
  providerUserId String
  createdAt DateTime @default(now())
  @@index([clientUserId, createdAt])
  @@index([providerUserId, createdAt])
}
